# 生图后端（OpenAI 兼容）。后台「设置」里填写的值优先于这里。
IMAGE_API_BASE_URL=https://code.fe.sb
IMAGE_API_KEY=your_api_key_here

# 初始管理员，仅在数据库首次初始化（还没有任何管理员）时生效
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123

# SQLite 数据目录（默认 ./data）。standalone 部署时 server.js 会 chdir 到 .next/standalone，
# 务必显式指定绝对路径，否则重新 build 会把数据库一起清掉。
# DATA_DIR=/root/projects/image-generate/data
