{
  "name": "image-generate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3006",
    "build": "next build",
    "postbuild": "D=${NEXT_DIST_DIR:-.next}; cp -R public $D/standalone/ && mkdir -p $D/standalone/$D && cp -R $D/static $D/standalone/$D/",
    "start": "D=${NEXT_DIST_DIR:-.next}; UPLOAD_TMP_DIR=$PWD/public/images/tmp UPLOAD_PERMANENT_DIR=$PWD/public/images/permanent DATA_DIR=$PWD/data HOSTNAME=0.0.0.0 PORT=${PORT:-3006} node $D/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@base-ui/react": "^1.4.1",
    "antd": "^6.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
